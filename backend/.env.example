PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:5000
# Generate a private random value with at least 32 characters. Do not commit it.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
# Google OAuth is optional. Register GOOGLE_CALLBACK_URL in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Set this only after verifying the PostgreSQL host, port, role, password, and database locally.
DATABASE_URL=
ENABLE_DEV_AUTH=false
DEV_ACTOR_EMAIL=
DEV_ACTOR_PASSWORD=
