generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  LEAD
  ONBOARDING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum RequirementStatus {
  DRAFT
  UNDER_REVIEW
  CONFIRMED
  CHANGES_REQUESTED
  ARCHIVED
}

enum RequirementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum RequirementItemStatus {
  PENDING
  CLARIFICATION
  ACCEPTED
}

enum CommunicationType {
  CALL
  EMAIL
  MEETING
  WHATSAPP_MESSAGE
  VIDEO_MEETING
  OTHER
}

enum ClientAssetType {
  FILE
  REFERENCE
}

model Agency {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  roles                 Role[]
  clients               Client[]
  projects              Project[]
  tasks                 Task[]
  notices               Notification[]
  auditLogs             AuditLog[]
  clientNotes           ClientNote[]
  requirements          ClientRequirement[]
  requirementItems      RequirementItem[]
  requirementReferences RequirementReference[]
  requirementRevisions  RequirementRevision[]
  communications        ClientCommunication[]
  assets                ClientAsset[]
}

model User {
  id                           String                 @id @default(uuid()) @db.Uuid
  agencyId                     String                 @db.Uuid
  roleId                       String?                @db.Uuid
  email                        String
  name                         String
  passwordHash                 String?
  googleId                     String?
  avatarUrl                    String?
  isActive                     Boolean                @default(true)
  lastLoginAt                  DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  agency                       Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  role                         Role?                  @relation(fields: [agencyId, roleId], references: [agencyId, id], onDelete: Restrict)
  notices                      Notification[]
  auditLogs                    AuditLog[]
  preparedRequirements         ClientRequirement[]    @relation("RequirementPreparedBy")
  confirmedRequirements        ClientRequirement[]    @relation("RequirementConfirmedBy")
  createdNotes                 ClientNote[]
  createdRequirementReferences RequirementReference[]
  createdRequirementRevisions  RequirementRevision[]
  createdCommunications        ClientCommunication[]
  uploadedAssets               ClientAsset[]

  @@unique([agencyId, id])
  @@unique([agencyId, email])
  @@index([agencyId])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  agencyId    String       @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions Permission[]

  @@unique([agencyId, name])
  @@unique([agencyId, id])
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  roles Role[]
}

model Client {
  id                 String                @id @default(uuid()) @db.Uuid
  agencyId           String                @db.Uuid
  name               String                @db.VarChar(150)
  primaryContactName String?               @db.VarChar(100)
  primaryEmail       String?               @db.VarChar(320)
  primaryPhone       String?               @db.VarChar(32)
  website            String?               @db.VarChar(2048)
  status             ClientStatus          @default(LEAD)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  agency             Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  projects           Project[]
  notes              ClientNote[]
  requirements       ClientRequirement[]
  communications     ClientCommunication[]
  assets             ClientAsset[]
  activityEvents     AuditLog[]            @relation("ClientAuditEvents")

  @@unique([agencyId, id])
  @@index([agencyId, status])
  @@index([agencyId, name])
}

model ClientNote {
  id         String   @id @default(uuid()) @db.Uuid
  agencyId   String   @db.Uuid
  clientId   String   @db.Uuid
  authorId   String   @db.Uuid
  content    String   @db.Text
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client     Client   @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  author     User     @relation(fields: [agencyId, authorId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, clientId, createdAt])
}

model ClientRequirement {
  id                String                 @id @default(uuid()) @db.Uuid
  agencyId          String                 @db.Uuid
  clientId          String                 @db.Uuid
  title             String?                @db.VarChar(150)
  businessObjective String?                @db.Text
  requestedServices String[]               @default([])
  designPreferences String?                @db.Text
  referenceLinks    String[]               @default([])
  budgetMin         Decimal?               @db.Decimal(12, 2)
  budgetMax         Decimal?               @db.Decimal(12, 2)
  currency          String?                @db.VarChar(3)
  expectedTimeline  String?                @db.VarChar(200)
  targetDate        DateTime?              @db.Timestamptz(3)
  constraints       String?                @db.Text
  assumptions       String?                @db.Text
  additionalNotes   String?                @db.Text
  preparedById      String                 @db.Uuid
  confirmedById     String?                @db.Uuid
  confirmedAt       DateTime?              @db.Timestamptz(3)
  status            RequirementStatus      @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  agency            Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client            Client                 @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  preparedBy        User                   @relation("RequirementPreparedBy", fields: [agencyId, preparedById], references: [agencyId, id], onDelete: Restrict)
  confirmedBy       User?                  @relation("RequirementConfirmedBy", fields: [agencyId, confirmedById], references: [agencyId, id], onDelete: Restrict)
  items             RequirementItem[]
  references        RequirementReference[]
  revisions         RequirementRevision[]
  communications    ClientCommunication[]
  assets            ClientAsset[]
  activityEvents    AuditLog[]             @relation("RequirementAuditEvents")

  @@unique([agencyId, id])
  @@unique([agencyId, clientId, id])
  @@index([agencyId, clientId, status, updatedAt])
}

model RequirementItem {
  id              String                @id @default(uuid()) @db.Uuid
  agencyId        String                @db.Uuid
  requirementId   String                @db.Uuid
  title           String?               @db.VarChar(150)
  description     String?               @db.Text
  category        String?               @db.VarChar(100)
  requirementType RequirementType       @default(FUNCTIONAL)
  itemStatus      RequirementItemStatus @default(PENDING)
  priority        RequirementPriority   @default(NORMAL)
  notes           String?               @db.Text
  sortOrder       Int
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  agency          Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  requirement     ClientRequirement     @relation(fields: [agencyId, requirementId], references: [agencyId, id], onDelete: Restrict)

  @@unique([requirementId, sortOrder])
  @@index([agencyId, requirementId, sortOrder])
}

model RequirementReference {
  id            String            @id @default(uuid()) @db.Uuid
  agencyId      String            @db.Uuid
  requirementId String            @db.Uuid
  createdById   String            @db.Uuid
  label         String            @db.VarChar(200)
  url           String            @db.VarChar(2048)
  createdAt     DateTime          @default(now())
  agency        Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  requirement   ClientRequirement @relation(fields: [agencyId, requirementId], references: [agencyId, id], onDelete: Restrict)
  createdBy     User              @relation(fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, requirementId])
}

model RequirementRevision {
  id              String            @id @default(uuid()) @db.Uuid
  agencyId        String            @db.Uuid
  requirementId   String            @db.Uuid
  version         Int
  contentSnapshot Json
  changeReason    String?           @db.Text
  confirmedById   String            @db.Uuid
  confirmedAt     DateTime          @db.Timestamptz(3)
  createdAt       DateTime          @default(now())
  agency          Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  requirement     ClientRequirement @relation(fields: [agencyId, requirementId], references: [agencyId, id], onDelete: Restrict)
  confirmedBy     User              @relation(fields: [agencyId, confirmedById], references: [agencyId, id], onDelete: Restrict)

  @@unique([requirementId, version])
  @@index([agencyId, requirementId, version])
}

model ClientCommunication {
  id            String             @id @default(uuid()) @db.Uuid
  agencyId      String             @db.Uuid
  clientId      String             @db.Uuid
  requirementId String?            @db.Uuid
  type          CommunicationType
  subject       String             @db.VarChar(200)
  summary       String             @db.Text
  participants  String[]           @default([])
  occurredAt    DateTime           @db.Timestamptz(3)
  followUpNotes String?            @db.Text
  createdById   String             @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  agency        Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client        Client             @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  requirement   ClientRequirement? @relation(fields: [agencyId, clientId, requirementId], references: [agencyId, clientId, id], onDelete: Restrict)
  createdBy     User               @relation(fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, clientId, occurredAt, id])
  @@index([agencyId, type, occurredAt])
}

model ClientAsset {
  id            String             @id @default(uuid()) @db.Uuid
  agencyId      String             @db.Uuid
  clientId      String             @db.Uuid
  requirementId String?            @db.Uuid
  type          ClientAssetType
  originalName  String?            @db.VarChar(255)
  mimeType      String?            @db.VarChar(100)
  fileSize      Int?
  storageKey    String?            @unique @db.VarChar(100)
  externalUrl   String?            @db.VarChar(2048)
  label         String             @db.VarChar(200)
  uploadedById  String             @db.Uuid
  uploadedAt    DateTime           @default(now())
  deletedAt     DateTime?
  agency        Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client        Client             @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  requirement   ClientRequirement? @relation(fields: [agencyId, clientId, requirementId], references: [agencyId, clientId, id], onDelete: Restrict)
  uploadedBy    User               @relation(fields: [agencyId, uploadedById], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, clientId, uploadedAt, id])
  @@index([agencyId, requirementId])
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  clientId  String   @db.Uuid
  name      String
  budget    Decimal? @db.Decimal(12, 2)
  currency  String?  @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client    Client   @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  tasks     Task[]

  @@unique([agencyId, id])
  @@index([agencyId, clientId])
}

model Task {
  id        String     @id @default(uuid()) @db.Uuid
  agencyId  String     @db.Uuid
  projectId String?    @db.Uuid
  title     String
  status    TaskStatus @default(TODO)
  dueAt     DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  project   Project?   @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, status])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  agencyId  String    @db.Uuid
  userId    String    @db.Uuid
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, userId, readAt])
}

model AuditLog {
  id            String             @id @default(uuid()) @db.Uuid
  agencyId      String             @db.Uuid
  actorId       String?            @db.Uuid
  clientId      String?            @db.Uuid
  requirementId String?            @db.Uuid
  eventAt       DateTime           @default(now()) @db.Timestamptz(3)
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  agency        Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor         User?              @relation(fields: [agencyId, actorId], references: [agencyId, id], onDelete: Restrict)
  client        Client?            @relation("ClientAuditEvents", fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  requirement   ClientRequirement? @relation("RequirementAuditEvents", fields: [agencyId, clientId, requirementId], references: [agencyId, clientId, id], onDelete: Restrict)

  @@index([agencyId, createdAt])
  @@index([agencyId, entityType, entityId])
  @@index([agencyId, clientId, createdAt, id])
  @@index([agencyId, clientId, eventAt, id])
}
