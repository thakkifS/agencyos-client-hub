generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  LEAD
  ONBOARDING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model Agency {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  roles     Role[]
  clients   Client[]
  projects  Project[]
  tasks     Task[]
  notices   Notification[]
  auditLogs AuditLog[]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  roleId    String?  @db.Uuid
  email     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  notices   Notification[]
  auditLogs AuditLog[]
  @@unique([agencyId, email])
  @@index([agencyId])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  agencyId    String       @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions Permission[]
  @@unique([agencyId, name])
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  roles Role[]
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  agencyId     String       @db.Uuid
  name         String
  primaryEmail String?
  status       ClientStatus @default(LEAD)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  projects     Project[]
  @@index([agencyId, status])
  @@index([agencyId, name])
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  clientId  String   @db.Uuid
  name      String
  budget    Decimal? @db.Decimal(12, 2)
  currency  String?  @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tasks     Task[]
  @@index([agencyId, clientId])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  agencyId    String     @db.Uuid
  projectId   String?    @db.Uuid
  title       String
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([agencyId, status])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  userId    String   @db.Uuid
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([agencyId, userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  agencyId   String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([agencyId, createdAt])
  @@index([agencyId, entityType, entityId])
}
